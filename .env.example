# Copy to .env for local dev (gitignored). None of these are required — the app runs in
# degraded/demo mode without them (see CLAUDE.md).

# Postgres connection string for quote-monitoring subscriptions.
# Free-tier options: Neon (neon.tech) or Supabase (supabase.com).
# Without this, subscriptions use an in-memory store that resets on restart.
DATABASE_URL=

# Cron expression for the recurring quote-check cycle. Defaults to "0 9 * * *" (daily at 9am)
# if unset. Each subscription is only actually re-priced when its own weekly/monthly interval
# is due — this just controls how often the app checks for due subscriptions.
CRON_SCHEDULE=

# HTTP port. Render sets its own PORT; local dev defaults to 4321.
PORT=
